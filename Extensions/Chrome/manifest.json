{
  "manifest_version": 3,
  "name": "freeico",
  "version": "1.0",
  "description": "Lightning fast open-source icon search side panel.",
  "icons": {
    "128": "icon128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": ["sidePanel"],
  "background": {
    "service_worker": "background.js"
  }
}
