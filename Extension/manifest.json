{
    "manifest_version": 3,
    "name": "SVG Downloader",
    "version": "1.0",
    "description": "Downloads all SVGs on the current page to a selected folder.",
    "permissions": [
        "activeTab",
        "scripting",
        "downloads"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html"
    }
}